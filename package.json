{
  "name": "perrins-barbershop",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "serve": "node scripts/serve.mjs",
    "sync": "node scripts/sync-services.mjs",
    "test": "node --test scripts/sync-services.test.mjs lib/hours.test.ts lib/calendar.test.ts lib/services.test.ts server/booking.test.ts",
    "canary": "node scripts/canary-booking.mjs",
    "fixture": "node scripts/save-fixture.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check:dashes": "node scripts/check-dashes.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/bodoni-moda": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/metro-runtime": "~57.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-server": "~57.0.3",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
