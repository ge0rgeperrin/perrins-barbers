{
  "expo": {
    "name": "Perrin's Barber Shop",
    "slug": "perrins-barbershop",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "perrins",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0B08",
    "primaryColor": "#C9A227",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.co.perrinsbarbers.app",
      "infoPlist": {
        "CFBundleDisplayName": "Perrin's",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhoneNumber",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      },
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png"
      }
    },
    "android": {
      "package": "uk.co.perrinsbarbers.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "name": "Perrin's Barber Shop",
      "shortName": "Perrin's",
      "favicon": "./assets/favicon.png",
      "themeColor": "#0C0B08",
      "backgroundColor": "#0C0B08",
      "description": "The Hertford Barber. Traditional barbering on Old Cross in Hertford since 1999. Prices, opening hours and online booking."
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://perrinsbarbers.co.uk"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0C0B08",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "_note": "eas.projectId identifies this app to EAS Build. Written by `eas init`, safe to commit, not a secret. See STORE.md.",
      "router": {},
      "eas": {
        "projectId": "75cf3e60-4715-4ae1-b1c9-2712a37fc45f"
      }
    },
    "owner": "ge0rgeperrin",
    "updates": {
      "url": "https://u.expo.dev/75cf3e60-4715-4ae1-b1c9-2712a37fc45f"
    }
  }
}
