# Copy to .env for local development. Real values go in the hosting
# environment, never in the repository.

# Where the site lives. No trailing slash.
#
# Read at BUILD time and inlined into the bundle by Metro, so it must be set
# before `expo export`, and changing it means a redeploy. Used for the canonical
# and og: tags, and as the base the phone apps call for prices and booking.
EXPO_PUBLIC_SITE_URL=https://perrinsbarbers.co.uk

# The key that encrypts a booking hold. 32 characters minimum.
#
# Server side only, never sent to a browser, and NOT prefixed EXPO_PUBLIC_ for
# exactly that reason. Booking refuses to start in production without it. It can
# be rotated at any time; the only cost is that holds created in the previous
# ten minutes stop being redeemable.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_SECRET=
